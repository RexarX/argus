@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(ARGUS_WAS_BUILT_SHARED "@ARGUS_BUILD_SHARED@")
set(ARGUS_BUILT_ALGO "@ARGUS_BUILD_ALGO@")
set(ARGUS_ENABLE_EMBREE_BACKEND "@ARGUS_ENABLE_EMBREE_BACKEND@")
set(ARGUS_EMBREE_VERSION "@ARGUS_EMBREE_VERSION@")
set(ARGUS_EMBREE_PACKAGE_DIR "@ARGUS_EMBREE_PACKAGE_DIR@")
set(ARGUS_EMBREE_RUNTIME_ROOT "@CMAKE_INSTALL_LIBDIR@/embree")
set(ARGUS_EMBREE_RUNTIME_NAMES "@ARGUS_EMBREE_RUNTIME_NAMES@")

if(ARGUS_ENABLE_EMBREE_BACKEND)
  set(embree_DIR "${PACKAGE_PREFIX_DIR}/${ARGUS_EMBREE_PACKAGE_DIR}")
  find_dependency(embree ${ARGUS_EMBREE_VERSION} CONFIG)
  if(TARGET embree)
    set_target_properties(embree PROPERTIES
        MAP_IMPORTED_CONFIG_DEBUG Release
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
        MAP_IMPORTED_CONFIG_MINSIZEREL Release
    )
    if(NOT TARGET argus::lib::embree)
      add_library(argus::lib::embree ALIAS embree)
    endif()
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/argusTargets.cmake")

if(ARGUS_ENABLE_EMBREE_BACKEND AND NOT ARGUS_WAS_BUILT_SHARED
    AND TARGET argus::lib::embree)
  if(TARGET argus::sim)
    set_property(TARGET argus::sim APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES argus::lib::embree
    )
  endif()
  if(TARGET argus::argus)
    get_target_property(_argus_type argus::argus TYPE)
    if(_argus_type STREQUAL "INTERFACE_LIBRARY")
      set_property(TARGET argus::argus APPEND PROPERTY
          INTERFACE_LINK_LIBRARIES "$<LINK_ONLY:argus::lib::embree>"
      )
    endif()
  endif()
endif()

function(argus_copy_runtime TARGET)
  if(NOT TARGET ${TARGET})
    message(FATAL_ERROR "argus_copy_runtime: '${TARGET}' is not a target")
  endif()
  if(WIN32 AND ARGUS_WAS_BUILT_SHARED AND TARGET argus::argus)
    add_custom_command(TARGET ${TARGET} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "$<TARGET_FILE:argus::argus>"
            "$<TARGET_FILE_DIR:${TARGET}>"
        COMMENT "Copy argus next to ${TARGET}"
    )
  endif()

  if(NOT ARGUS_EMBREE_RUNTIME_NAMES)
    return()
  endif()
  if(WIN32)
    set(_runtime_dir "${PACKAGE_PREFIX_DIR}/${ARGUS_EMBREE_RUNTIME_ROOT}/bin")
  else()
    set(_runtime_dir "${PACKAGE_PREFIX_DIR}/${ARGUS_EMBREE_RUNTIME_ROOT}/lib")
  endif()
  foreach(_name IN LISTS ARGUS_EMBREE_RUNTIME_NAMES)
    add_custom_command(TARGET ${TARGET} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "${_runtime_dir}/${_name}"
            "$<TARGET_FILE_DIR:${TARGET}>"
        COMMENT "Copy ${_name} next to ${TARGET}"
    )
  endforeach()
endfunction()
