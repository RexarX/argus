#pragma once

/// @file version_macros.h
/// @brief Compile-time argus version. Generated from CMake `project(VERSION ...)`.

#define ARGUS_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ARGUS_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ARGUS_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define ARGUS_VERSION_STRING "@PROJECT_VERSION@"
